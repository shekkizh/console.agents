# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_APP_URL=https://console.shekkizh.com

# Neon
# Use a separate local database (or Neon branch) so development migrations and
# test cleanup can never touch the deployed database.
DATABASE_NAME=console_agents_dev

DATABASE_URL=

# Signs short-lived message wake and sandbox API tokens. Set a separate random value in production.
# Local development falls back to CLERK_SECRET_KEY when omitted.
CONSOLE_INTERNAL_SECRET=

# Optional full URL for the sandbox-facing messaging API. Local Microsandbox
# defaults to http://host.microsandbox.internal:3000/api/a2a; production
# defaults to NEXT_PUBLIC_APP_URL/api/a2a.
CONSOLE_AGENT_API_URL=

# Vercel AI Gateway. Eve uses this in trusted code; the key is passed only to
# the fx process while an agent turn is active.
AI_GATEWAY_API_KEY=

# Optional model/runtime overrides
EVE_MODEL_ID=zai/glm-5.2
FX_MODEL=minimax/minimax-m3-free
FX_VERSION=v0.0.4
